         <widget class="QWidget" name="page_help">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_6">
           <property name="spacing">
            <number>0</number>
           </property>
           <property name="leftMargin">
            <number>0</number>
           </property>
           <property name="topMargin">
            <number>0</number>
           </property>
           <property name="rightMargin">
            <number>0</number>
           </property>
           <property name="bottomMargin">
            <number>0</number>
           </property>
           <item>
            <widget class="QTextBrowser" name="textBrowser">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
               <horstretch>100</horstretch>
               <verstretch>100</verstretch>
              </sizepolicy>
             </property>
             <property name="html">
              <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;title&gt;Relay-D Help&lt;/title&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Ubuntu Sans'; font-size:11pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;table border=&quot;0&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px;&quot; width=&quot;100%&quot; cellspacing=&quot;0&quot; cellpadding=&quot;30&quot;&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;img src=&quot;:/img/resources/img/inesctec_logo.png&quot; alt=&quot;INESC TEC Logo&quot; /&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;h1 align=&quot;center&quot; style=&quot; margin-top:16px; margin-bottom:24px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:xx-large; font-weight:600;&quot;&gt;Relay-D — Help &amp;amp; Documentation &lt;/span&gt;&lt;/h1&gt;
&lt;h2 style=&quot; margin-top:20px; margin-bottom:8px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:x-large; font-weight:600;&quot;&gt;About Relay-D&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt;Relay-D is a Qt-based desktop application designed for data collection and dataset building to support Learning from Demonstration (LfD) models. It enables researchers and developers to efficiently capture, organize, and prepare demonstration data for machine learning. &lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot; margin-top:20px; margin-bottom:8px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:x-large; font-weight:600;&quot;&gt;Getting Started &lt;/span&gt;&lt;/h2&gt;
&lt;h3 style=&quot; margin-top:14px; margin-bottom:6px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:large; font-weight:600;&quot;&gt;What is Learning from Demonstration?&lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt;LfD is a machine learning approach where models learn tasks by observing expert demonstrations rather than through explicit programming. Relay-D provides an intuitive interface for collecting high-quality demonstration data. &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:14px; margin-bottom:6px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:large; font-weight:600;&quot;&gt;Key Features&lt;/span&gt;&lt;/h3&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Intuitive Qt Interface&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; — User-friendly desktop app with native look and feel&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Cross-Platform&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; — Runs on Windows, macOS, and Linux&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Data Capture&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; — Record demonstration sequences with real-time feedback&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Dataset Organization&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; — Structure collected data for optimal training&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Quality Control&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; — Review and validate data through the GUI&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Export Options&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; — HDF5, Pickle, and other formats &lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;h2 style=&quot; margin-top:20px; margin-bottom:8px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:x-large; font-weight:600;&quot;&gt;How to Use Relay-D&lt;/span&gt;&lt;/h2&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Launch the Relay-D application&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Import a configuration file via the &lt;/span&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Import&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; page&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Go to &lt;/span&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Start Recording&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; to open the sensor/camera view&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Use &lt;/span&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Recording Controls&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; in the sidebar to start, pause, and stop&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Use &lt;/span&gt;&lt;span style=&quot; font-size:14px; font-weight:600;&quot;&gt;Data Post Process&lt;/span&gt;&lt;span style=&quot; font-size:14px;&quot;&gt; to convert collected data &lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;
&lt;h2 style=&quot; margin-top:20px; margin-bottom:8px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:x-large; font-weight:600;&quot;&gt;System Requirements&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt;Qt 5.12+ • 4 GB RAM min (8 GB recommended) • 1 GB disk space • Compatible recording hardware &lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot; margin-top:20px; margin-bottom:8px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:x-large; font-weight:600;&quot;&gt;About&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px; font-weight:600;&quot;&gt;Relay-D&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt; is developed by INESC TEC.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px; font-weight:600;&quot;&gt;Authors:&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt; Pedro Dias, Artur Cordeiro&lt;br /&gt;&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px; font-weight:600;&quot;&gt;Organization:&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt; INESC TEC&lt;br /&gt;&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px; font-weight:600;&quot;&gt;License:&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','sans-serif'; font-size:14px;&quot;&gt; GNU GPLv3 &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="openExternalLinks">
