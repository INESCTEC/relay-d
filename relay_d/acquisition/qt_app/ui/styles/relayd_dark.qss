QWidget[container_id="camera_top"] {
    background-color: #2A3442 !important;
    border-left: 3px solid #60A5FA !important;
}

QWidget[container_id="camera_front"] {
    background-color: #2C3340 !important;
    border-left: 3px solid #818CF8 !important;
}

QWidget[container_id="joints_data"] {
    background-color: #2B3540 !important;
    border-left: 3px solid #4ADE80 !important;
}

QWidget[container_id="pose_data"] {
    background-color: #2D3340 !important;
    border-left: 3px solid #FBBF24 !important;
}
*/

/* ---------------------------------------------------------------------------
 * 22. Message Boxes — using same palette but slightly different styling for emphasis
 * --------------------------------------------------------------------------- */

/* Message Box */
QDialog#CustomMessageBox {
    background-color: #1F2937;
    border: 1px solid #374151;
    border-radius: 10px;
}

QDialog#CustomMessageBox QLabel#msgBodyLabel {
    color: #9CA3AF;
    font-size: 12px;
}